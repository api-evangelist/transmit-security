          "info": {
            "name": "Get organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sbx.transmitsecurity.io/cis/v1/organizations",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/oidc/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Retrieve a list of all organizations. This should be called from the backend, using an admin access token (generated by a management app). <br><br>**Required permissions**: `organizations:read`, `orgs:read`, `organizations:list`, `orgs:list`."
        },
        {
          "info": {
            "name": "Create organization",
            "type": "http"
